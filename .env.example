# Multi-provider failover + free tier
# -----------------------------------
# TTS: the deprecated `openai/tts-1` is gone (400 "does not exist").
# LIVE-VERIFIED at $0 balance on the /audio/speech endpoint:
#   mistralai/voxtral-mini-tts-2603  voice: en_paul_neutral  (returns real MP3)
# STT: openai/whisper-large-v3-turbo is still valid but requires >= $0.50 balance (402).
# VITE_OPENROUTER_TTS_MODEL=mistralai/voxtral-mini-tts-2603
# VITE_OPENROUTER_VOICE=en_paul_neutral
#
# Free tier: any OpenRouter key works; switch the toggle (or set this to true)
# and all OpenRouter chats route to VITE_OPENROUTER_FREE_MODEL instead of the
# paid main model.
#
# Verified against the live API with a $0-balance key:
#   nvidia/nemotron-3-super-120b-a12b:free   VERIFIED working at $0 (text, 262k ctx)
#   google/gemma-4-31b-it:free               in catalog (vision+text) but providers
#                                            returned transient errors during testing
#   thinkingmachines/inkling:free            costs $0 but only runs from approved
#                                            "agentic harness" apps; plain API rejected
#   cohere/north-mini-code:free              in catalog (code, 256k ctx)
#
# NOTE: `cognitivecomputations/dolphin-mistral-24b-venice-edition:free` and
# `meta-llama/llama-3.3-70b-instruct:free` DO NOT exist on OpenRouter. The API
# answers with "This model is unavailable for free ... use the paid slug".
# The plain slugs (without `:free`) were both LIVE-verified answering at $0
# balance — pick them from the Settings model presets. They are billed at their
# catalog rates (approx $0.1-0.2/M prompt) once the account holds balance.
#
# PROVIDER NOTE: these models keep their own alignment and use-policy
# guardrails. Big G adds none beyond the RULE_GATE approval step for
# destructive local commands - free-tier keys do not disable that gate.
VITE_OPENROUTER_FREE_TIER=false
VITE_OPENROUTER_FREE_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Camera frames and any other image input automatically route to this model
# (text-only presets like dolphin/llama/nemotron would 404 with "No endpoints
# found that support image input"). gpt-4o-mini supports vision.
# VITE_OPENROUTER_VISION_MODEL=openai/gpt-4o-mini

# Backup if OpenRouter is rate-limited. Both are optional; leave blank to
# disable failover. Keys are inlined into the bundle at build time.
# VITE_GITHUB_MODELS_TOKEN=            # https://github.com/settings/tokens (fine-grained or classic)
# VITE_GOOGLE_AI_STUDIO_KEY=           # https://aistudio.google.com/apikey