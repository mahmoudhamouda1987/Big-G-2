# OpenRouter API key used by src/aiService.ts (streaming chat via OpenRouter endpoints).
# Copy this file to .env and fill in a real key, or provide the key at runtime.
# VITE_ variables are inlined into the frontend bundle at build time.
VITE_OPENROUTER_API_KEY=sk-or-v1-your-key-here
VITE_OPENROUTER_MODEL=openai/gpt-4o-mini

# Speech pipeline (Big G voice-in / voice-out)
# NOTE: OpenRouter gates audio behind a $0.50 minimum account balance.
VITE_OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
VITE_OPENROUTER_TTS_MODEL=openai/tts-1
VITE_OPENROUTER_VOICE=alloy

# Research / web-search agent
VITE_OPENROUTER_RESEARCH_MODEL=google/gemini-2.5-flash